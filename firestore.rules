rules_version = '2';

// ===============================================================
// Assumed Data Model
// ===============================================================
//
// This security rules file assumes the following data structures:
//
// Collection: users
// Document ID: {userId} (matches Firebase Auth UID)
// Fields:
//   - email: string (optional)
//   - isPremium: boolean (required)
//   - licenseType: string (required)
//   - accessUntil: string (required)
//   - usage: map (required, must have audits and generations as numbers)
//   - createdAt: string (required)
//
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {
    
    // ===============================================================
    // Helper Functions
    // ===============================================================
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }
    
    function isValidUserDoc() {
      let data = request.resource.data;
      return hasRequiredFields(['isPremium', 'licenseType', 'usage', 'createdAt', 'accessUntil']) &&
             data.isPremium is bool &&
             data.licenseType is string && data.licenseType.size() < 50 &&
             data.accessUntil is string &&
             data.usage is map &&
             ('audits' in data.usage && data.usage.audits is number) &&
             ('generations' in data.usage && data.usage.generations is number) &&
             data.createdAt is string &&
             (!('email' in data) || data.email == null || data.email is string);
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUserDoc();
      // Updates and deletes are handled exclusively by the backend
      allow update, delete: if false;

      // Allow access to chat sessions history
      match /sessions/{sessionId} {
        allow read, write, delete: if isOwner(userId);
      }
    }
    
    match /{document=**} {
      allow read, write: if false;
    }
  }
}