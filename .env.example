# Supabase Configuration (Required)
VITE_SUPABASE_URL=YOUR_SUPABASE_PROJECT_URL
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY # Keep secret, used in API routes

# Gemini API Key (Required for AI)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# Stripe Configuration (Required for Payments)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Stripe Price IDs (Server-side - NO prefix for API routes)
STRIPE_PRICE_ANALISIS=price_...
STRIPE_PRICE_DRAFT=price_...
STRIPE_PRICE_MENSUALIDAD=price_...

# Stripe Price IDs (Client-side)
VITE_STRIPE_PRICE_ANALISIS=price_...
VITE_STRIPE_PRICE_DRAFT=price_...
VITE_STRIPE_PRICE_MENSUALIDAD=price_...

# API URL (Optional, defaults to relative /api)
VITE_API_URL=/api
