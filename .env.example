# Supabase Configuration (Required)
VITE_SUPABASE_URL=YOUR_SUPABASE_PROJECT_URL
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY # Keep secret, used in API routes

# Gemini API Key (Required for AI)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# Stripe Configuration (Required for Payments)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Stripe Price IDs (Update with your own from Stripe Dashboard)
VITE_STRIPE_PRICE_AUDIT=price_1TApWv36rYdwQu28DCjR7H5e
VITE_STRIPE_PRICE_DRAFT=price_1TApYv36rYdwQu28o3LMAZjU
VITE_STRIPE_PRICE_3_MONTHS=price_1TApaN36rYdwQu28h1Mfljni
VITE_STRIPE_PRICE_6_MONTHS=price_1TApbX36rYdwQu28667fMy2l

# API URL (Optional, defaults to relative /api)
VITE_API_URL=/api
