# Lex API MX (server-only; never prefix with VITE_)
LEX_API_MX_KEY=
LEX_API_MX_BASE_URL=https://api.lexapi.mx

# Gemini API Key (optional fallback embeddings)
GOOGLE_GENERATIVE_AI_API_KEY=YOUR_GEMINI_API_KEY

# Google Analytics 4 (GA4) Measurement ID (ej: G-XXXXXXXXXX)
VITE_GA_MEASUREMENT_ID=

# Google AdSense Publisher Client ID (ej: ca-pub-XXXXXXXXXXXXXXXX)
VITE_ADSENSE_CLIENT_ID=

# Optional: expose Vite dev server on LAN
VITE_EXPOSE_DEV_SERVER=false
